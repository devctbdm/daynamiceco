{
  "name": "apple-it-zone-backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node server.js",
    "worker:notifications": "node scripts/notification-worker.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pre-commit": "npm run lint:fix && npm run format",
    "build": "find server.js src scripts test -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "db:generate": "drizzle-kit generate",
    "db:import-users": "node scripts/import-users-to-neon.js",
    "db:import-team-members": "node scripts/import-team-members-to-neon.js",
    "db:import-sliders": "node scripts/import-sliders-to-neon.js",
    "db:import-sessions": "node scripts/import-sessions-to-neon.js",
    "db:import-sms-setting": "node scripts/import-sms-setting-to-neon.js",
    "db:import-sms-logs": "node scripts/import-sms-logs-to-neon.js",
    "db:import-saved-builds": "node scripts/import-saved-builds-to-neon.js",
    "db:import-notifications": "node scripts/import-notifications-to-neon.js",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.21.0",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "sslcommerz-lts": "^1.2.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.5"
  }
}
