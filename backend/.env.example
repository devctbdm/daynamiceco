# ==========================================
# Application
# ==========================================
NODE_ENV=production
PORT=5000


# ==========================================
# PostgreSQL / Neon (primary datastore)
# ==========================================
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require
DATABASE_SSL=true
# Headroom for parallel admin requests + fire-and-forget audit writes during
# Neon cold starts; a starved pool makes pages hang on their loading skeleton.
DATABASE_POOL_MAX=20
# Fail fast (retryable 500) instead of hanging forever when no connection can
# be established / acquired.
DATABASE_CONNECT_TIMEOUT_MS=15000
# Products at or below this stock level appear in the dashboard "Stock alerts"
# panel (default 5).
DASHBOARD_LOW_STOCK_THRESHOLD=5


# ==========================================
# Legacy Mongo -> Neon importers (scripts/ only)
# ==========================================
# Not used by the API at runtime. Only needed when running the historical
# one-off importers in scripts/, which also require `npm i -D mongoose`.
# DB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/<DATABASE_NAME>


# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ==========================================
# JWT
# ==========================================
JWT_SECRET=your_strong_random_jwt_secret


# ==========================================
# Frontend / Backend URLs
# ==========================================
# Production frontend URL
FRONTEND_URL=https://your-frontend-domain.com

# Production backend URL
BACKEND_URL=https://your-backend-domain.com


# ==========================================
# Trust Proxy
# ==========================================
# Render / Railway / similar platforms:
# Usually 1 is appropriate when the app is behind one proxy.
TRUST_PROXY=1


# ==========================================
# CORS
# ==========================================
# Comma-separated allowed frontend origins.
# Example:
# CORS_ORIGINS=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com


# ==========================================
# Redis
# ==========================================
REDIS_ENABLED=true
REDIS_TLS=true
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your_redis_host
REDIS_PORT=6379

# Default cache TTL in seconds
REDIS_TTL=300
# Notification delivery uses a Redis Stream; the API starts a worker
# automatically. Additional `npm run worker:notifications` instances can share
# the queue. Configure Redis persistence/replication; at capacity, new events
# fail fast.
# The worker also removes read notifications after 24 hours and unread ones
# after 30 days; the daily cleanup sweep may make removal up to 24 hours later.
NOTIFICATION_QUEUE_MAX_LENGTH=100000
NOTIFICATION_WORKER_BATCH_SIZE=100
NOTIFICATION_CLAIM_IDLE_MS=60000


# ==========================================
# Resend Email
# ==========================================
RESEND_API_KEY=your_resend_api_key

# After verifying your domain:
# Example:
# RESEND_FROM=Apple IT Zone <no-reply@yourdomain.com>
RESEND_FROM=Apple IT Zone <no-reply@yourdomain.com>

EMAIL_ENABLED=true


# ==========================================
# Google Analytics 4
# ==========================================
GA_ENABLED=false
GA4_PROPERTY_ID=123456789
GA4_CLIENT_EMAIL=ga4-reader@your-project.iam.gserviceaccount.com
# Store the JSON key private_key with literal \n characters on one line.
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"


# ==========================================
# Meta / Facebook Product Catalog
# ==========================================
# Keep disabled until the Meta credentials have been configured and tested.
META_CATALOG_SYNC_ENABLED=false
META_API_VERSION=v23.0
META_BUSINESS_ID=your_meta_business_id
META_CATALOG_ID=your_product_catalog_id
META_ACCESS_TOKEN=your_long_lived_system_user_token
META_CATALOG_COUNTRY=BD
META_CATALOG_CURRENCY=BDT